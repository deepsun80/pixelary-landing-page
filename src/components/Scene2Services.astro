---

---

<section class="scene scene-2" id="scene-2">
  <div class="services-inner">
    <div class="section-head">
      <span class="eyebrow eyebrow-lg">What We Build</span>
      <h2>Three systems, one engine.</h2>
    </div>
    <div class="cards-container" id="diamonds-container">
      <!-- Card 1: Web Design & SEO -->
      <div class="service-card" id="diamond-1">
        <div class="card-header">
          <span class="card-num">01</span>
          <div class="icon-wrapper">
            <img
              src="/desktop-icon.png"
              alt="Web Design"
              class="service-icon"
              width="46"
              height="46"
              loading="lazy"
            />
          </div>
        </div>
        <div class="card-content" id="diamond-content-1">
          <h3>Web Design<br />&amp; SEO</h3>
          <p>
            Stop losing customers to slow templates. We engineer custom digital
            experiences designed to rank high and convert visitors into leads.
          </p>
        </div>
        <div class="card-hair"><i></i></div>
      </div>

      <!-- Card 2: Intelligent Capture -->
      <div class="service-card" id="diamond-2">
        <div class="card-header">
          <span class="card-num">02</span>
          <div class="icon-wrapper">
            <img
              src="/pin-icon.png"
              alt="Intelligent Capture"
              class="service-icon"
              width="46"
              height="46"
              loading="lazy"
            />
          </div>
        </div>
        <div class="card-content" id="diamond-content-2">
          <h3>Intelligent<br />Capture</h3>
          <p>
            Your business should never sleep. We implement 'Always-On' technology
            that secures leads the moment they express interest.
          </p>
        </div>
        <div class="card-hair"><i></i></div>
      </div>

      <!-- Card 3: Client Retention -->
      <div class="service-card" id="diamond-3">
        <div class="card-header">
          <span class="card-num">03</span>
          <div class="icon-wrapper">
            <img
              src="/funnel-icon.png"
              alt="Client Retention"
              class="service-icon"
              width="46"
              height="46"
              loading="lazy"
            />
          </div>
        </div>
        <div class="card-content" id="diamond-content-3">
          <h3>Client<br />Retention</h3>
          <p>
            We don't just find customers; we keep them. Our systems automatically
            re-engage past leads and drive repeat business.
          </p>
        </div>
        <div class="card-hair"><i></i></div>
      </div>
    </div>
  </div>
</section>
