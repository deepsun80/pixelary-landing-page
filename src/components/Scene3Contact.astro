---

---

<section class="scene scene-3" id="scene-3">
  <!-- Diagonal gradient backgrounds - two layers for sequential animation -->
  <canvas class="gradient-layer gradient-gold" id="gradient-gold" aria-hidden="true"></canvas>
  <canvas class="gradient-layer gradient-light" id="gradient-light" aria-hidden="true"></canvas>

  <!-- Content container -->
  <div class="scene-3-content">
    <!-- Left side: Text -->
    <div class="contact-text" id="contact-text">
      <span class="eyebrow eyebrow-lg">Request a Quote</span>
      <h2>Ready to <em>Scale?</em></h2>
      <div class="hr"></div>
      <p>
        Stop losing leads to outdated systems. Let's build the digital infrastructure that turns
        visitors into loyal clients.
      </p>
    </div>

    <!-- Right side: Contact form -->
    <div class="contact-form-wrapper" id="contact-form-wrapper">
      <form class="contact-form" id="contact-form">
        <div>
          <label class="form-label" for="f-name">Full Name</label>
          <input id="f-name" type="text" name="name" placeholder="Jane Whitmore" required />
        </div>
        <div>
          <label class="form-label" for="f-email">Email Address</label>
          <input id="f-email" type="email" name="email" placeholder="jane@company.com" required />
        </div>
        <div>
          <label class="form-label" for="f-msg">Your Message</label>
          <textarea
            id="f-msg"
            name="message"
            placeholder="Tell us about your business…"
            rows="3"
            required
          ></textarea>
        </div>
        <button type="submit" class="btn btn-clay btn-send" id="btn-send">Send Message</button>
        <p class="form-status" id="form-status"></p>
      </form>
    </div>
  </div>

  <script>
    // Pixel-cell diagonal fold: two dithered bands drawn on canvases (seeded, deterministic)
    const goldCv = document.getElementById('gradient-gold') as HTMLCanvasElement | null;
    const lightCv = document.getElementById('gradient-light') as HTMLCanvasElement | null;
    const sceneEl = document.getElementById('scene-3');

    const drawFold = () => {
      if (!goldCv || !lightCv || !sceneEl) return;
      const W = sceneEl.clientWidth;
      const H = sceneEl.clientHeight;
      const dpr = window.devicePixelRatio || 1;
      const cell = 9;
      const b1 = 0.42;
      const b2 = 0.56;
      const spread = 110;
      const cs = getComputedStyle(document.documentElement);
      const pale = cs.getPropertyValue('--clay-pale').trim();
      const light = cs.getPropertyValue('--clay-light').trim();
      const ctxs = [goldCv, lightCv].map((cv) => {
        cv.width = W * dpr;
        cv.height = H * dpr;
        const c = cv.getContext('2d')!;
        c.scale(dpr, dpr);
        c.clearRect(0, 0, W, H);
        return c;
      });
      const [gold, soft] = ctxs;
      gold.fillStyle = light;
      soft.fillStyle = pale;

      const S = W + H;
      const sp = spread / S;
      let seed = 7;
      const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
      const flip = (t: number, b: number) => {
        const d = t - b;
        if (Math.abs(d) > sp) return d > 0;
        const p = 0.5 + 0.5 * (d / sp);
        return rnd() < p * p * (3 - 2 * p);
      };
      for (let gy = 0; gy < H; gy += cell) {
        for (let gx = 0; gx < W; gx += cell) {
          const t = (gx + gy + cell) / S;
          const in2 = flip(t, b2);
          const in1 = flip(t, b1);
          if (in2) gold.fillRect(gx, gy, cell, cell);
          else if (in1) soft.fillRect(gx, gy, cell, cell);
        }
      }
    };
    drawFold();
    if (sceneEl) new ResizeObserver(drawFold).observe(sceneEl);

    const form = document.getElementById(
      'contact-form',
    ) as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const submitBtn = form.querySelector(
        '.btn-send',
      ) as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;
      }

      try {
        const response = await fetch('https://formspree.io/f/xreqdqgj', {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });

        if (response.ok) {
          if (status) {
            status.textContent = 'Message sent successfully!';
            status.className = 'form-status success';
          }
          form.reset();
        } else {
          if (status) {
            status.textContent = 'Something went wrong. Please try again.';
            status.className = 'form-status error';
          }
        }
      } catch (error) {
        if (status) {
          status.textContent = 'Something went wrong. Please try again.';
          status.className = 'form-status error';
        }
      }

      if (submitBtn) {
        submitBtn.textContent = 'Send Message';
        submitBtn.disabled = false;
      }
    });
  </script>
</section>
