---

---

<section class="scene scene-2" id="scene-2">
  <div class="services-inner">
    <div class="section-head">
      <span class="eyebrow eyebrow-lg">What You Get</span>
    </div>
    <div class="cards-container" id="diamonds-container">
      <div class="service-card" id="diamond-1">
        <div class="card-header">
          <div class="icon-wrapper">
            <img
              src="/desktop-icon.png"
              alt="Web Design"
              class="service-icon"
              width="46"
              height="46"
              loading="lazy"
            />
          </div>
        </div>
        <div class="card-content" id="diamond-content-1">
          <h3>Get Found<span class="card-sub">Web Design &amp; SEO</span></h3>
          <p class="card-summary">Show up first on local searches, Google and in AI answers.</p>
          <ul>
            <li>Custom, lightning-fast, mobile-ready website</li>
            <li>Local SEO + AI search (AEO) optimized</li>
            <li>Google Business Profile setup &amp; optimization</li>
            <li>Hosting, security &amp; ongoing maintenance</li>
          </ul>
        </div>
        <div class="card-hair"><i></i></div>
      </div>

      <div class="service-card" id="diamond-2">
        <div class="card-header">
          <div class="icon-wrapper">
            <img
              src="/pin-icon.png"
              alt="Intelligent Capture"
              class="service-icon"
              width="46"
              height="46"
              loading="lazy"
            />
          </div>
        </div>
        <div class="card-content" id="diamond-content-2">
          <h3>Get Booked<span class="card-sub">Intelligent Capture</span></h3>
          <p class="card-summary">Every inquiry answered, qualified and booked.</p>
          <ul>
            <li>Automatic lead qualification</li>
            <li>Online booking &amp; payment portals</li>
            <li>Every lead captured in your custom CRM</li>
            <li>AI chat assistant &amp; instant replies</li>
          </ul>
        </div>
        <div class="card-hair"><i></i></div>
      </div>

      <div class="service-card" id="diamond-3">
        <div class="card-header">
          <div class="icon-wrapper">
            <img
              src="/funnel-icon.png"
              alt="Client Retention"
              class="service-icon"
              width="46"
              height="46"
              loading="lazy"
            />
          </div>
        </div>
        <div class="card-content" id="diamond-content-3">
          <h3>Get Them Back<span class="card-sub">Client Retention</span></h3>
          <p class="card-summary">Past customers return, and fresh reviews keep coming in.</p>
          <ul>
            <li>Automated follow-ups that win back leads</li>
            <li>Auto review requests on Google &amp; Yelp</li>
            <li>Seasonal promos &amp; reminders by text and email</li>
            <li>Monthly reports on leads, calls &amp; growth</li>
          </ul>
        </div>
        <div class="card-hair"><i></i></div>
      </div>
    </div>
  </div>
</section>
