---

---

<section class="scene scene-1" id="scene-1">
  <div class="masthead-rail">
    <div class="row eyebrow">
      <span>Digital Growth Studio</span><span>Austin, Texas</span><span>Web · Capture · Retention</span>
    </div>
    <div class="rule"></div>
  </div>
  <div class="hero-content">
    <img
      src="/logo-pixelary.png"
      alt="Pixelary"
      class="hero-logo"
      id="hero-logo"
      width="918"
      height="401"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-rules"><i></i><i></i></div>
    <div class="hero-tagline" id="hero-tagline">
      <span>Innovation</span><i></i><span>Growth</span><i></i><span>Success</span>
    </div>
    <p class="hero-sub" id="hero-sub">
      Pixelary builds growth systems that bring in customers, book them automatically, and keep them
      coming back.
    </p>
  </div>
  <div class="scroll-indicator" id="scroll-indicator">
    <span class="lbl">Scroll</span>
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
    >
      <path d="M7 10l5 5 5-5"></path>
    </svg>
  </div>
</section>
